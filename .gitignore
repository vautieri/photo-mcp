# OS / scratch
*.log
*~

# Cassette recordings — re-record on demand, do not commit private API responses
tests/integration/cassettes/*.yaml
!tests/integration/cassettes/.gitkeep

# Reference photos may include private originals — opt in per file
tests/fixtures/photos/*
!tests/fixtures/photos/.gitkeep
!tests/fixtures/photos/PROVENANCE.md

# Local secrets — paranoia layer; the API key lives in env, not on disk
.env
.env.*
!.env.example

# Provenance sidecars produced during local runs
*.photo-mcp.json
